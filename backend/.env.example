# Database
DATABASE_URL=postgresql://user:password@localhost:5432/aviation

# System user id used when persisting system-generated alerts (set after running prisma seed)
# Example: SYSTEM_USER_ID=cl0abc1230000xyz
SYSTEM_USER_ID=

# SMTP for email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL_TO=

# Other runtime settings
PORT=3000
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://aviation_admin:SecurePassword123!@localhost:5432/aviation_db?schema=public
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info